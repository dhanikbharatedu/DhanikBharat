
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#092c46">

  <title>Dhanik Bharat Educational Institutions | Official Links</title>

  <meta name="description" content="Explore official Dhanik Bharat Educational Institutions social media channels, campus locations, admissions, student and parent apps. Admissions Open 2027-2028.">

  <link rel="icon" href="logo.png" type="image/png">

  <style>
    :root {
      --navy: #092c46;
      --blue: #124c70;
      --gold: #d7a84b;
      --light: #f4f7fa;
      --text: #183044;
      --muted: #667788;
      --white: #ffffff;
      --border: #e5ebf0;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--light);
      color: var(--text);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .page-wrapper {
      width: 100%;
      max-width: 1440px;
      margin: auto;
      padding: 35px 5%;
    }

    .hero {
      text-align: center;
      padding: 30px 20px 40px;
    }

    .logo {
      width: 110px;
      height: 110px;
      object-fit: contain;
      margin-bottom: 18px;
    }

    .hero h1 {
      color: var(--navy);
      font-size: clamp(28px, 4vw, 42px);
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 12px;
    }

    .hero p {
      color: var(--muted);
      font-size: 16px;
      max-width: 700px;
      margin: 0 auto;
    }

    .admission-tag {
      display: inline-block;
      background: var(--gold);
      color: #172b3b;
      padding: 9px 20px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1px;
      margin-top: 22px;
    }

    .section {
      margin-top: 45px;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 25px;
    }

    .section-heading h2 {
      color: var(--navy);
      font-size: clamp(23px, 3vw, 30px);
      font-weight: 800;
      margin-bottom: 7px;
    }

    .section-heading p {
      color: var(--muted);
      font-size: 14px;
    }

    .social-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    .social-card {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 65px;
      padding: 15px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
      color: var(--navy);
      font-size: 15px;
      font-weight: 700;
      text-align: center;
      transition: 0.25s ease;
    }

    .social-card:hover {
      background: var(--navy);
      color: var(--white);
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(9, 44, 70, 0.12);
    }

    .app-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
      max-width: 750px;
      margin: auto;
    }

    .app-card {
      background: var(--navy);
      color: var(--white);
      text-align: center;
      padding: 20px;
      border-radius: 12px;
      font-weight: 700;
      transition: 0.25s ease;
    }

    .app-card:hover {
      background: var(--blue);
      transform: translateY(-3px);
    }

    .city-section {
      margin-top: 55px;
    }

    .city-title {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 22px;
      color: var(--navy);
      font-size: 23px;
      font-weight: 800;
    }

    .city-title::after {
      content: "";
      height: 2px;
      flex: 1;
      background: var(--border);
    }

    .campus-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .campus-card {
      overflow: hidden;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 14px;
      box-shadow: 0 5px 18px rgba(20, 50, 70, 0.05);
      transition: 0.25s ease;
    }

    .campus-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 25px rgba(20, 50, 70, 0.1);
    }

    .campus-image {
      width: 100%;
      aspect-ratio: 4 / 5;
      display: block;
      object-fit: contain;
      background: #eef2f5;
    }

    .campus-info {
      padding: 18px;
    }

    .campus-info h3 {
      color: var(--navy);
      font-size: 17px;
      line-height: 1.35;
      margin-bottom: 8px;
    }

    .campus-location {
      color: var(--muted);
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .campus-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }

    .tag {
      display: inline-block;
      padding: 5px 10px;
      background: #edf4f8;
      color: var(--blue);
      border-radius: 30px;
      font-size: 11px;
      font-weight: 700;
    }

    .contact-section {
      margin-top: 55px;
      padding: 35px 25px;
      background: var(--navy);
      color: var(--white);
      border-radius: 16px;
      text-align: center;
    }

    .contact-section h2 {
      font-size: 25px;
      margin-bottom: 15px;
    }

    .contact-section p {
      font-size: 14px;
      margin: 7px 0;
      color: #e2eaf0;
      overflow-wrap: anywhere;
    }

    .contact-section a {
      color: #f2c66d;
      font-weight: 700;
    }

    .office-details {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
      margin-top: 25px;
      text-align: left;
    }

    .office-details h3 {
      color: #f2c66d;
      font-size: 16px;
      margin-bottom: 8px;
    }

    footer {
      text-align: center;
      padding: 28px 10px 10px;
      color: var(--muted);
      font-size: 12px;
    }

    @media (max-width: 900px) {
      .social-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .campus-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      .page-wrapper {
        padding: 20px 15px;
      }

      .hero {
        padding: 20px 5px 30px;
      }

      .logo {
        width: 90px;
        height: 90px;
      }

      .hero p {
        font-size: 14px;
      }

      .section {
        margin-top: 35px;
      }

      .social-grid,
      .app-grid,
      .campus-grid,
      .office-details {
        grid-template-columns: 1fr;
      }

      .social-card {
        min-height: 58px;
      }

      .city-section {
        margin-top: 40px;
      }

      .city-title {
        font-size: 20px;
      }

      .campus-grid {
        gap: 18px;
      }

      .campus-info {
        padding: 15px;
      }

      .contact-section {
        padding: 28px 18px;
      }

      .office-details {
        text-align: center;
      }
    }
  </style>
</head>

<body>

  <main class="page-wrapper">

    <!-- HEADER -->
    <header class="hero">
      <img src="logo.png" alt="Dhanik Bharat Logo" class="logo">

      <h1>Dhanik Bharat Educational Institutions</h1>

      <p>
        Empowering students through academic excellence,
        integrated learning and a student-centric approach.
      </p>

      <div class="admission-tag">
        ADMISSIONS OPEN 2027–2028
      </div>
    </header>

    <!-- SOCIAL MEDIA -->
    <section class="section">
      <div class="section-heading">
        <h2>Connect With Us</h2>
        <p>Follow our official channels for updates, events and announcements.</p>
      </div>

      <div class="social-grid">
        <a class="social-card" href="https://dhanikbharat.org/" target="_blank" rel="noopener">Official Website</a>

        <a class="social-card" href="https://www.facebook.com/profile.php?id=61584293831919" target="_blank" rel="noopener">Facebook</a>

        <a class="social-card" href="https://www.instagram.com/dhanikbharatedu/?hl=en" target="_blank" rel="noopener">Instagram</a>

        <a class="social-card" href="https://www.youtube.com/@dhanikbharat-edu" target="_blank" rel="noopener">YouTube</a>

        <a class="social-card" href="https://x.com/dhanikbharatedu" target="_blank" rel="noopener">Twitter / X</a>

        <a class="social-card" href="https://www.linkedin.com/company/dhanikbharat/" target="_blank" rel="noopener">LinkedIn</a>

        <a class="social-card" href="https://whatsapp.com/channel/0029Vb75B9Y5kg72eCv86T0Z" target="_blank" rel="noopener">WhatsApp Channel</a>

        <a class="social-card" href="https://api.whatsapp.com/send/?phone=919555825559" target="_blank" rel="noopener">WhatsApp Support</a>
      </div>
    </section>

    <!-- STUDENT / PARENT APP -->
    <section class="section">
      <div class="section-heading">
        <h2>Student / Parent App</h2>
        <p>Access the Dhanik Bharat app through your preferred platform.</p>
      </div>

      <div class="app-grid">
        <a class="app-card"
           href="https://play.google.com/store/apps/details?id=com.mcb.dhanikbharateducationalsociety"
           target="_blank" rel="noopener">
          Google Play Store
        </a>

        <a class="app-card"
           href="https://apps.apple.com/us/app/dhanik-bharat-institutions/id6770435192"
           target="_blank" rel="noopener">
          Apple App Store
        </a>
      </div>
    </section>

    <!-- ADMISSIONS -->
    <section class="section">
      <div class="section-heading">
        <h2>Admissions Open 2027–2028</h2>
        <p>Take the next step towards your academic goals.</p>
      </div>

      <div class="app-grid">
        <a class="app-card"
           href="https://dhanikbharat.org/#enquiry-form"
           target="_blank" rel="noopener">
          Enquire for Admissions
        </a>

        <a class="app-card"
           href="https://api.whatsapp.com/send/?phone=919555825559"
           target="_blank" rel="noopener">
          Contact Admissions Team
        </a>
      </div>
    </section>

    <!-- HYDERABAD CAMPUSES -->
    <section class="city-section">
      <h2 class="city-title">Hyderabad Campuses</h2>

      <div class="campus-grid">

        <article class="campus-card">
          <img class="campus-image" src="HYD/Harvard Campus -  MADHAPUR.jpg" alt="Harvard Campus Madhapur">
          <div class="campus-info">
            <h3>Harvard Campus</h3>
            <p class="campus-location">Madhapur, Hyderabad</p>
            <div class="campus-tags">
              <span class="tag">Residential</span>
              <span class="tag">Boys</span>
            </div>
          </div>
        </article>

        <article class="campus-card">
          <img class="campus-image" src="HYD/MIT Campus-MADHAPUR.jpg" alt="MIT Campus Madhapur">
          <div class="campus-info">
            <h3>MIT Campus</h3>
            <p class="campus-location">Madhapur, Hyderabad</p>
            <div class="campus-tags">
              <span class="tag">Residential</span>
              <span class="tag">Boys</span>
            </div>
          </div>
        </article>

        <article class="campus-card">
          <img class="campus-image" src="HYD/Caltech Campus - BONGULURU.jpg" alt="Caltech Campus Bonguluru">
          <div class="campus-info">
            <h3>Caltech Campus</h3>
            <p class="campus-location">Bonguluru, Hyderabad</p>
            <div class="campus-tags">
              <span class="tag">Residential</span>
              <span class="tag">Boys</span>
            </div>
          </div>
        </article>

        <article class="campus-card">
          <img class="campus-image" src="HYD/Stanford Campus - MADHAPUR.jpg" alt="Stanford Campus Madhapur">
          <div class="campus-info">
            <h3>Stanford Campus</h3>
            <p class="campus-location">Madhapur, Hyderabad</p>
            <div class="campus-tags">
              <span class="tag">Residential</span>
              <span class="tag">Girls</span>
            </div>
          </div>
        </article>

        <article class="campus-card">
          <img class="campus-image" src="HYD/Boston Campus - MADINAGUDA.jpg" alt="Boston Campus Madinaguda">
          <div class="campus-info">
            <h3>Boston Campus</h3>
            <p class="campus-location">Madinaguda, Hyderabad</p>
            <div class="campus-tags">
              <span class="tag">Day Scholar</span>
            </div>
          </div>
        </article>

        <article class="campus-card">
          <img class="campus-image" src="HYD/Michigan Campus - KUKATPALLY.jpg" alt="Michigan Campus Kukatpally">
          <div class="campus-info">
            <h3>Michigan Campus</h3>
            <p class="campus-location">Kukatpally, Hyderabad</p>
            <div class="campus-tags">
              <span class="tag">Day Scholar</span>
            </div>
          </div>
        </article>

        <article class="campus-card">
          <img class="campus-image" src="HYD/Cornell Campus - LB NAGAR.jpg" alt="Cornell Campus LB Nagar">
          <div class="campus-info">
            <h3>Cornell Campus</h3>
            <p class="campus-location">LB Nagar, Hyderabad</p>
            <div class="campus-tags">
              <span class="tag">Day Scholar</span>
              <span class="tag">Semi-Residential</span>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- VIJAYAWADA CAMPUSES -->
    <section class="city-section">
      <h2 class="city-title">Vijayawada Campuses</h2>

      <div class="campus-grid">

        <article class="campus-card">
          <img class="campus-image" src="Vijayawada/Harvard Campus - RAMAVARAPADU.jpg" alt="Harvard Campus Ramavarapadu">
          <div class="campus-info">
            <h3>Harvard Campus</h3>
            <p class="campus-location">Ramavarapadu, Vijayawada</p>
            <div class="campus-tags">
              <span class="tag">Residential</span>
              <span class="tag">Semi-Residential</span>
              <span class="tag">Day Scholar</span>
              <span class="tag">Boys</span>
            </div>
          </div>
        </article>

        <article class="campus-card">
          <img class="campus-image" src="Vijayawada/Stanford Campus - RAMAVARAPADU.jpg" alt="Stanford Campus Ramavarapadu">
          <div class="campus-info">
            <h3>Stanford Campus</h3>
            <p class="campus-location">Ramavarapadu, Vijayawada</p>
            <div class="campus-tags">
              <span class="tag">Residential</span>
              <span class="tag">Semi-Residential</span>
              <span class="tag">Day Scholar</span>
              <span class="tag">Girls</span>
            </div>
          </div>
        </article>

        <article class="campus-card">
          <img class="campus-image" src="Vijayawada/Boston Campus - LABBIPET.jpg" alt="Boston Campus Labbipet">
          <div class="campus-info">
            <h3>Boston Campus</h3>
            <p class="campus-location">Labbipet, Vijayawada</p>
            <div class="campus-tags">
              <span class="tag">Day Scholar</span>
              <span class="tag">Semi-Residential</span>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- GUNTUR CAMPUSES -->
    <section class="city-section">
      <h2 class="city-title">Guntur Campuses</h2>

      <div class="campus-grid">

        <article class="campus-card">
          <img class="campus-image" src="Guntur/Harvard Campus - PEDDAPALAKLURU.jpg" alt="Harvard Campus Peddapalakluru">
          <div class="campus-info">
            <h3>Harvard Campus</h3>
            <p class="campus-location">Peddapalakluru, Guntur</p>
            <div class="campus-tags">
              <span class="tag">Residential</span>
              <span class="tag">Boys</span>
            </div>
          </div>
        </article>

        <article class="campus-card">
          <img class="campus-image" src="Guntur/Stanford Campus - REDDY PALEM.jpg" alt="Stanford Campus Reddy Palem">
          <div class="campus-info">
            <h3>Stanford Campus</h3>
            <p class="campus-location">Reddy Palem, Guntur</p>
            <div class="campus-tags">
              <span class="tag">Residential</span>
              <span class="tag">Girls</span>
            </div>
          </div>
        </article>

        <article class="campus-card">
          <img class="campus-image" src="Guntur/Queensland - ASHOKNAGAR.jpg" alt="Queensland Campus Ashok Nagar">
          <div class="campus-info">
            <h3>Queensland Campus</h3>
            <p class="campus-location">Ashok Nagar, Guntur</p>
            <div class="campus-tags">
              <span class="tag">Residential</span>
              <span class="tag">Girls</span>
            </div>
          </div>
        </article>

        <article class="campus-card">
          <img class="campus-image" src="Guntur/Boston Campus - ZUDIO BUILDING.jpg" alt="Boston Campus Zudio Building">
          <div class="campus-info">
            <h3>Boston Campus</h3>
            <p class="campus-location">Zudio Building, Guntur</p>
            <div class="campus-tags">
              <span class="tag">Day Scholar</span>
              <span class="tag">Semi-Residential</span>
            </div>
