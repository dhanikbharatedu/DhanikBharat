        </article>

      </div>
    </section>

    <!-- VIZAG CAMPUSES -->
    <section class="city-section">
      <h2 class="city-title">Visakhapatnam Campuses</h2>

      <div class="campus-grid">

        <article class="campus-card">
          <img class="campus-image" src="Vizag/Harvard Campus - CARSHED JUNCTION.jpg" alt="Harvard Campus Carshed Junction">
          <div class="campus-info">
            <h3>Harvard Campus</h3>
            <p class="campus-location">Carshed Junction, Visakhapatnam</p>
            <div class="campus-tags">
              <span class="tag">Residential</span>
              <span class="tag">Semi-Residential</span>
              <span class="tag">Day Scholar</span>
              <span class="tag">Boys</span>
            </div>
          </div>
        </article>

        <article class="campus-card">
          <img class="campus-image" src="Vizag/Stanford Campus - CARSHED JUNCTION.jpg" alt="Stanford Campus Carshed Junction">
          <div class="campus-info">
            <h3>Stanford Campus</h3>
            <p class="campus-location">Carshed Junction, Visakhapatnam</p>
            <div class="campus-tags">
              <span class="tag">Residential</span>
              <span class="tag">Semi-Residential</span>
              <span class="tag">Day Scholar</span>
              <span class="tag">Girls</span>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- CONTACT DETAILS -->
    <section class="contact-section">
      <h2>Get in Touch</h2>

      <p>
        Phone:
        <a href="tel:+919555825559">+91 955582 5559</a>
      </p>

      <p>
        Email:
        <a href="mailto:info@dhanikbharat.org">info@dhanikbharat.org</a>
      </p>

      <div class="office-details">
        <div>
          <h3>Registered Office</h3>
          <p>
            Unit No. 3A, Wing B, 2nd Floor, Times Square,
            Marol, Andheri (East), Mumbai – 400059.
          </p>
        </div>

        <div>
          <h3>Corporate Office</h3>
          <p>
            Sai Plaza, MIG 366, 4th Floor, KPHB Colony,
            Kukatpally, Hyderabad, Telangana – 500072.
          </p>
        </div>
      </div>
    </section>

    <footer>
      © 2027 Dhanik Bharat Educational Institutions.
      All Rights Reserved.
    </footer>

  </main>

</body>
</html>
