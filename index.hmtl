
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#092c46">

<title>Dhanik Bharat Educational Institutions | Official Links</title>

<meta name="description" content="Explore Dhanik Bharat Educational Institutions official social media channels, Hyderabad campuses, student and parent apps, and admissions for 2027-2028.">

<link rel="icon" href="logo.png" type="image/png">

<style>
:root {
  --navy: #092c46;
  --blue: #15577b;
  --gold: #d7a84b;
  --light: #f4f7fa;
  --white: #ffffff;
  --text: #19364b;
  --muted: #657788;
  --border: #e2e9ee;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: var(--light);
  color: var(--text);
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

.container {
  max-width: 1440px;
  margin: auto;
  padding: 30px 5%;
}

/* HEADER */

.hero {
  text-align: center;
  padding: 35px 15px 45px;
}

.logo {
  width: 115px;
  height: 115px;
  object-fit: contain;
  margin-bottom: 20px;
}

.hero h1 {
  font-size: clamp(27px, 4vw, 44px);
  color: var(--navy);
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 15px;
}

.hero p {
  max-width: 720px;
  margin: auto;
  font-size: 16px;
  color: var(--muted);
}

.admission-badge {
  display: inline-block;
  margin-top: 23px;
  padding: 10px 24px;
  border-radius: 30px;
  background: var(--gold);
  color: #172c3b;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 1px;
}

/* SECTION HEADINGS */

.section {
  margin-top: 45px;
}

.section-heading {
  text-align: center;
  margin-bottom: 26px;
}

.section-heading h2 {
  font-size: clamp(23px, 3vw, 30px);
  color: var(--navy);
  margin-bottom: 7px;
}

.section-heading p {
  color: var(--muted);
  font-size: 14px;
}

/* SOCIAL LINKS */

.social-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
}

.social-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 66px;
  padding: 16px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 13px;
  color: var(--navy);
  font-size: 15px;
  font-weight: 700;
  text-align: center;
  transition: 0.25s;
}

.social-card:hover {
  background: var(--navy);
  color: var(--white);
  transform: translateY(-3px);
  box-shadow: 0 8px 22px rgba(9,44,70,0.13);
}

/* APPS & ADMISSIONS */

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 15px;
  max-width: 800px;
  margin: auto;
}

.action-card {
  background: var(--navy);
  color: white;
  border-radius: 13px;
  padding: 20px;
  text-align: center;
  font-size: 15px;
  font-weight: 700;
  transition: 0.25s;
}

.action-card:hover {
  background: var(--blue);
  transform: translateY(-3px);
}

/* CAMPUS SECTION */

.city-section {
  margin-top: 60px;
}

.city-heading {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 25px;
  font-size: 25px;
  color: var(--navy);
}

.city-heading::after {
  content: "";
  flex: 1;
  height: 2px;
  background: var(--border);
}

.campus-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 23px;
}

.campus-card {
  background: white;
  border-radius: 15px;
  border: 1px solid var(--border);
  overflow: hidden;
  box-shadow: 0 5px 20px rgba(0,0,0,0.05);
  transition: 0.25s;
}

.campus-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(9,44,70,0.12);
}

/* FULL IMAGE - NO CROPPING */

.campus-image {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 5;
  object-fit: contain;
  background: #edf1f5;
}

.campus-info {
  padding: 19px;
}

.campus-info h3 {
  color: var(--navy);
  font-size: 18px;
  margin-bottom: 5px;
}

.campus-location {
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 13px;
  font-weight: 600;
}

.campus-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.tag {
  display: inline-block;
  background: #eaf2f8;
  color: var(--blue);
  padding: 5px 11px;
  border-radius: 30px;
  font-size: 11px;
  font-weight: 700;
}

/* CONTACT */

.contact {
  margin-top: 60px;
  background: var(--navy);
  border-radius: 18px;
  padding: 40px 30px;
  color: white;
  text-align: center;
}

.contact h2 {
  font-size: 27px;
  margin-bottom: 18px;
}

.contact p {
  font-size: 14px;
  color: #e2ebf2;
  margin-bottom: 8px;
  overflow-wrap: anywhere;
}

.contact a {
  color: #f2c66d;
  font-weight: 700;
}

.office-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 30px;
  margin-top: 30px;
  text-align: left;
}

.office-grid h3 {
  color: #f2c66d;
  font-size: 17px;
  margin-bottom: 10px;
}

footer {
  padding: 30px 10px 10px;
  text-align: center;
  color: var(--muted);
  font-size: 12px;
}

/* TABLET */

@media (max-width: 900px) {
  .social-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .campus-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* MOBILE */

@media (max-width: 600px) {
  .container {
    padding: 20px 15px;
  }

  .hero {
    padding: 20px 5px 30px;
  }

  .logo {
    width: 95px;
    height: 95px;
  }

  .hero p {
    font-size: 14px;
  }

  .section {
    margin-top: 35px;
  }

  .social-grid,
  .action-grid,
  .campus-grid,
  .office-grid {
    grid-template-columns: 1fr;
  }

  .social-card {
    min-height: 58px;
  }

  .city-section {
    margin-top: 42px;
  }

  .city-heading {
    font-size: 21px;
  }

  .campus-grid {
    gap: 18px;
  }

  .contact {
    padding: 30px 18px;
  }

  .office-grid {
    text-align: center;
  }
}
</style>
</head>

<body>

<main class="container">

<!-- HEADER -->

<header class="hero">

  <img src="logo.png" alt="Dhanik Bharat Logo" class="logo">

  <h1>Dhanik Bharat Educational Institutions</h1>

  <p>
    Empowering students through academic excellence,
    integrated learning and a student-centric approach.
  </p>

  <div class="admission-badge">
    ADMISSIONS OPEN 2027–2028
  </div>

</header>

<!-- SOCIAL MEDIA -->

<section class="section">

  <div class="section-heading">
    <h2>Connect With Us</h2>
    <p>Stay connected with our official digital platforms.</p>
  </div>

  <div class="social-grid">

    <a class="social-card" href="https://dhanikbharat.org/" target="_blank" rel="noopener">
      Official Website
    </a>

    <a class="social-card" href="https://www.facebook.com/profile.php?id=61584293831919" target="_blank" rel="noopener">
