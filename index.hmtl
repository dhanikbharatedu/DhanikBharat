      YouTube
    </a>

    <a class="social-card" href="https://x.com/dhanikbharatedu" target="_blank" rel="noopener">
      Twitter / X
    </a>

    <a class="social-card" href="https://www.linkedin.com/company/dhanikbharat/" target="_blank" rel="noopener">
      LinkedIn
    </a>

    <a class="social-card" href="https://whatsapp.com/channel/0029Vb75B9Y5kg72eCv86T0Z" target="_blank" rel="noopener">
      WhatsApp Channel
    </a>

    <a class="social-card" href="https://api.whatsapp.com/send/?phone=919555825559" target="_blank" rel="noopener">
      WhatsApp Support
    </a>

  </div>

</section>

<!-- STUDENT / PARENT APP -->

<section class="section">

  <div class="section-heading">
    <h2>Student / Parent App</h2>
    <p>Download the official Dhanik Bharat mobile application.</p>
  </div>

  <div class="action-grid">

    <a class="action-card"
       href="https://play.google.com/store/apps/details?id=com.mcb.dhanikbharateducationalsociety"
       target="_blank" rel="noopener">
      Google Play Store
    </a>

    <a class="action-card"
       href="https://apps.apple.com/us/app/dhanik-bharat-institutions/id6770435192"
       target="_blank" rel="noopener">
      Apple App Store
    </a>

  </div>

</section>

<!-- ADMISSIONS -->

<section class="section">

  <div class="section-heading">
    <h2>Admissions Open 2027–2028</h2>
    <p>Begin your academic journey with Dhanik Bharat.</p>
  </div>

  <div class="action-grid">

    <a class="action-card"
       href="https://dhanikbharat.org/#enquiry-form"
       target="_blank" rel="noopener">
      Enquire for Admissions
    </a>

    <a class="action-card"
       href="https://api.whatsapp.com/send/?phone=919555825559"
       target="_blank" rel="noopener">
      Contact Admissions Team
    </a>

  </div>

</section>

<!-- HYDERABAD CAMPUSES -->

<section class="city-section">

  <h2 class="city-heading">Hyderabad Campuses</h2>

  <div class="campus-grid">

    <!-- HARVARD -->

    <article class="campus-card">

      <img
        class="campus-image"
        src="HYD/Harvard%20Campus%20-%20%20MADHAPUR.jpg"
        alt="Harvard Campus Madhapur"
        loading="lazy">

      <div class="campus-info">
        <h3>Harvard Campus</h3>
        <p class="campus-location">Madhapur, Hyderabad</p>

        <div class="campus-tags">
          <span class="tag">Residential</span>
          <span class="tag">Boys</span>
        </div>
      </div>

    </article>

    <!-- MIT -->

    <article class="campus-card">

      <img
        class="campus-image"
        src="HYD/MIT%20Campus-MADHAPUR.jpg"
