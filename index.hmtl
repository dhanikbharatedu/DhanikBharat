        <p class="campus-location">Madhapur, Hyderabad</p>

        <div class="campus-tags">
          <span class="tag">Residential</span>
          <span class="tag">Boys</span>
        </div>
      </div>

    </article>

    <!-- CALTECH -->

    <article class="campus-card">

      <img
        class="campus-image"
        src="HYD/Caltech%20Campus%20-%20BONGULURU.jpg"
        alt="Caltech Campus Bonguluru"
        loading="lazy">

      <div class="campus-info">
        <h3>Caltech Campus</h3>
        <p class="campus-location">Bonguluru, Hyderabad</p>

        <div class="campus-tags">
          <span class="tag">Residential</span>
          <span class="tag">Boys</span>
        </div>
      </div>

    </article>

    <!-- STANFORD -->

    <article class="campus-card">

      <img
        class="campus-image"
        src="HYD/Stanford%20Campus%20-%20MADHAPUR.jpg"
        alt="Stanford Campus Madhapur"
        loading="lazy">

      <div class="campus-info">
        <h3>Stanford Campus</h3>
        <p class="campus-location">Madhapur, Hyderabad</p>

        <div class="campus-tags">
          <span class="tag">Residential</span>
          <span class="tag">Girls</span>
        </div>
      </div>

    </article>

    <!-- BOSTON -->

    <article class="campus-card">

      <img
        class="campus-image"
        src="HYD/Boston%20Campus%20-%20MADINAGUDA.jpg"
        alt="Boston Campus Madinaguda"
        loading="lazy">

      <div class="campus-info">
        <h3>Boston Campus</h3>
        <p class="campus-location">Madinaguda, Hyderabad</p>

        <div class="campus-tags">
          <span class="tag">Day Scholar</span>
        </div>
      </div>

    </article>

    <!-- MICHIGAN -->

    <article class="campus-card">

      <img
        class="campus-image"
        src="HYD/Michigan%20Campus%20-%20KUKATPALLY.jpg"
        alt="Michigan Campus Kukatpally"
        loading="lazy">

