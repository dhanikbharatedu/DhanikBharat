
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#ffffff">
<meta name="description" content="Dhanik Bharat Educational Institutions - Admissions Open 2027-2028. Official links, campuses and Student / Parent App.">
<title>Dhanik Bharat | Official Links</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
:root {
    --green: #005b2b;
    --orange: #f45120;
    --text: #183047;
    --muted: #64748b;
    --light: #f7f9fc;
    --border: #e1e7ee;
    --boys-bg: #e7f0ff;
    --boys-text: #174ea6;
    --girls-bg: #fff0f5;
    --girls-text: #b42361;
    --day-bg: #fff8e8;
    --day-text: #8a5b00;
}

* {
    box-sizing: border-box;
}

html {
    width: 100%;
    overflow-x: hidden;
}

body {
    margin: 0;
    padding: 32px;
    width: 100%;
    font-family: 'Poppins', sans-serif;
    color: var(--text);
    background: #f3f6f8;
}

/* MAIN WEBSITE CONTAINER */
.container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 42px;
    background: #ffffff;
    border-radius: 26px;
    border-top: 8px solid var(--orange);
    box-shadow: 0 14px 45px rgba(15, 23, 42, .08);
}

header {
    text-align: center;
}

.logo {
    display: block;
    width: 100%;
    max-width: 210px;
    max-height: 230px;
    object-fit: contain;
    margin: 0 auto 12px;
}

h1 {
    margin: 0 0 5px;
    color: var(--green);
    font-size: 34px;
    font-weight: 700;
}

.subtitle {
    margin: 0 0 28px;
    color: var(--muted);
    font-size: 15px;
}

/* ADMISSIONS BUTTON */
.cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    margin-bottom: 28px;
    padding: 19px 16px;
    border-radius: 16px;
    background: linear-gradient(100deg, #ff7417, #ffc914);
    color: #172033;
    font-size: 19px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 10px 25px rgba(244, 113, 24, .20);
    transition: transform .2s ease;
}

.cta:hover {
    transform: translateY(-2px);
}

/* SECTION HEADINGS */
.section-title {
    margin: 34px 0 14px;
    color: var(--green);
    font-size: 23px;
    font-weight: 700;
}

.section-description {
    margin: -6px 0 18px;
    color: var(--muted);
    font-size: 14px;
}

/* SOCIAL MEDIA GRID */
.links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
}

.link-btn {
    display: flex;
    align-items: center;
    gap: 13px;
    min-height: 62px;
    padding: 15px 18px;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: var(--light);
    color: var(--text);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: background .2s ease, transform .2s ease;
}

.link-btn:hover {
    background: #edf4ef;
    transform: translateY(-2px);
}

.link-btn i {
    flex: 0 0 24px;
    width: 24px;
    text-align: center;
    font-size: 21px;
}

.fa-globe { color: #1687d9; }
.fa-facebook-f { color: #1877f2; }

.fa-instagram {
    background: linear-gradient(45deg, #feda75, #fa7e1e, #d62976, #962fbf, #4f5bd5);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.fa-youtube { color: #ff0000; }
.fa-x-twitter { color: #000; }
.fa-linkedin-in { color: #0a66c2; }
.fa-whatsapp { color: #25d366; }
.fa-bullhorn { color: var(--orange); }
.fa-apple { color: #111827; }
.fa-google-play { color: #18a058; }

.fa-graduation-cap,
.fa-location-dot {
    color: var(--orange);
}

/* STUDENT / PARENT APP */
.app-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.app-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 68px;
    padding: 16px;
    border-radius: 14px;
    background: var(--green);
    color: #fff;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    transition: opacity .2s ease;
}

.app-btn:hover {
    opacity: .88;
}

.app-btn i {
    font-size: 28px;
}

.app-btn small {
    display: block;
    font-size: 11px;
    font-weight: 400;
    opacity: .9;
}

/* CAMPUS DIRECTORY */
.location-group {
    margin-top: 30px;
}

.location-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    padding-bottom: 12px;
    border-bottom: 2px solid #e8eee9;
    color: var(--green);
    font-size: 22px;
    font-weight: 700;
}

.location-heading i {
    color: var(--orange);
    font-size: 22px;
}

.branch-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
}

.branch {
    min-width: 0;
    padding: 19px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #fbfcfd;
    overflow-wrap: anywhere;
    transition: border-color .2s ease, transform .2s ease;
}

.branch:hover {
    border-color: #a5cd39;
    transform: translateY(-2px);
}

.branch-campus {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 9px;
    color: var(--green);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.6;
}

.branch-campus i {
    flex: 0 0 16px;
    margin-top: 4px;
    color: var(--orange);
    font-size: 15px;
}

.branch-type {
    display: block;
    padding-left: 26px;
    color: #526174;
    font-size: 13px;
    line-height: 1.8;
}

.branch-type strong {
    color: var(--muted);
    font-weight: 600;
}

/* CAMPUS CATEGORY */
.campus-gender {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 10px 0 0 26px;
    padding: 6px 11px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
}

.campus-gender.boys {
    background: var(--boys-bg);
    color: var(--boys-text);
    border: 1px solid #c6dafc;
}

.campus-gender.girls {
    background: var(--girls-bg);
    color: var(--girls-text);
    border: 1px solid #f8c8dc;
}

.campus-gender.day {
    background: var(--day-bg);
    color: var(--day-text);
    border: 1px solid #f1d99b;
}

.campus-gender i {
    font-size: 12px;
}

/* CONTACT */
.divider {
    margin: 34px 0 24px;
    border: 0;
    border-top: 1px solid var(--border);
}

.contact {
    font-size: 15px;
    line-height: 1.9;
    overflow-wrap: anywhere;
}

.contact a {
    color: var(--green);
    text-decoration: none;
}

.contact-label {
    color: var(--green);
    font-weight: 700;
}

.address-block {
    margin-top: 22px;
}

.footer {
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    text-align: center;
    color: var(--muted);
    font-size: 13px;
}

/* LARGE DESKTOP SCREENS */
@media (min-width: 1500px) {
    .container {
        max-width: 1500px;
        padding: 48px;
    }

    .links {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .branch-list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

/* TABLET */
@media (min-width: 641px) and (max-width: 1024px) {
    body {
        padding: 22px;
    }

    .container {
        max-width: 100%;
        padding: 30px;
    }

    .links,
    .branch-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .section-title {
        font-size: 21px;
    }
}

/* MOBILE */
@media (max-width: 640px) {
    body {
        padding: 10px;
    }

    .container {
        width: 100%;
        max-width: 100%;
        padding: 22px 15px;
        border-radius: 18px;
        border-top-width: 6px;
    }

    .logo {
        max-width: 165px;
        max-height: 180px;
    }

    h1 {
        font-size: 26px;
    }

    .subtitle {
        font-size: 12px;
        margin-bottom: 22px;
    }

    .cta {
        padding: 15px 10px;
        font-size: 16px;
        border-radius: 13px;
    }

    .section-title {
        margin: 26px 0 12px;
        font-size: 19px;
    }

    .section-description {
        font-size: 12px;
        line-height: 1.7;
    }

    .links,
    .app-links,
    .branch-list {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .link-btn {
        min-height: 55px;
        padding: 12px 14px;
        font-size: 14px;
    }

    .app-btn {
        min-height: 60px;
        font-size: 14px;
    }

    .location-group {
        margin-top: 24px;
    }

    .location-heading {
        font-size: 19px;
    }

    .branch {
        padding: 15px;
    }

    .branch-campus {
        font-size: 13px;
    }

    .branch-type {
        font-size: 12px;
    }

    .contact {
        font-size: 13px;
    }

    .footer {
        font-size: 11px;
    }
}
</style>
</head>

<body>
<main class="container">

<!-- HEADER -->
<header>
    <img src="logo.png"
         alt="Dhanik Bharat Educational Institutions Logo"
         class="logo">

    <h1>Dhanik Bharat</h1>
    <p class="subtitle">Educational Institutions • Official Links</p>
</header>

<!-- ADMISSIONS -->
<a class="cta" href="https://dhanikbharat.org/#enquiry-form">
    <i class="fa-solid fa-graduation-cap"></i>
    Admissions Open 2027–2028
</a>

<!-- SOCIAL MEDIA -->
<section aria-label="Official social media links">
    <h2 class="section-title">Connect With Us</h2>

    <div class="links">

        <a class="link-btn" href="https://dhanikbharat.org/" target="_blank" rel="noopener noreferrer">
            <i class="fa-solid fa-globe"></i> Visit Website
        </a>

        <a class="link-btn" href="https://www.facebook.com/profile.php?id=61584293831919" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-facebook-f"></i> Facebook
        </a>

        <a class="link-btn" href="https://www.instagram.com/dhanikbharatedu/?hl=en" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-instagram"></i> Instagram
        </a>

        <a class="link-btn" href="https://www.youtube.com/@dhanikbharat-edu" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-youtube"></i> YouTube
        </a>

        <a class="link-btn" href="https://x.com/dhanikbharatedu" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-x-twitter"></i> Twitter (X)
        </a>

        <a class="link-btn" href="https://www.linkedin.com/company/dhanikbharat/" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-linkedin-in"></i> LinkedIn
        </a>

        <a class="link-btn" href="https://api.whatsapp.com/send/?phone=919555825559" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-whatsapp"></i> WhatsApp Support
        </a>

        <a class="link-btn" href="https://whatsapp.com/channel/0029Vb75B9Y5kg72eCv86T0Z" target="_blank" rel="noopener noreferrer">
            <i class="fa-solid fa-bullhorn"></i> WhatsApp Channel
        </a>

    </div>
</section>

<!-- STUDENT / PARENT APP -->
<section aria-label="Student and Parent App">
    <h2 class="section-title">Student / Parent App</h2>

    <p class="section-description">
        Access the Dhanik Bharat Student / Parent App on your device.
    </p>

    <div class="app-links">

        <a class="app-btn" href="https://apps.apple.com/us/app/dhanik-bharat-institutions/id6770435192" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-apple"></i>
            <span>
                <small>DOWNLOAD ON THE</small>
                App Store (iOS)
            </span>
        </a>

        <a class="app-btn" href="https://play.google.com/store/apps/details?id=com.mcb.dhanikbharateducationalsociety" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-google-play"></i>
            <span>
                <small>GET IT ON</small>
                Google Play (Android)
            </span>
        </a>

    </div>
</section>

<!-- CAMPUS DIRECTORY -->
<section aria-label="Dhanik Bharat campus directory">

    <h2 class="section-title">Our Branches</h2>

    <p class="section-description">
        Explore our campuses across Hyderabad, Vijayawada, Guntur and Vizag.
    </p>

    <!-- HYDERABAD -->
    <div class="location-group">
        <h3 class="location-heading">
            <i class="fa-solid fa-location-dot"></i> Hyderabad
        </h3>

        <div class="branch-list">

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Harvard Campus - MADHAPUR</span>
                <span class="branch-type"><strong>Campus Type:</strong> Residential Campus</span>
                <span class="campus-gender boys"><i class="fa-solid fa-person"></i> Boys Campus</span>
            </div>

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> MIT Campus - MADHAPUR</span>
                <span class="branch-type"><strong>Campus Type:</strong> Residential Campus</span>
                <span class="campus-gender boys"><i class="fa-solid fa-person"></i> Boys Campus</span>
            </div>

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Caltech Campus - BONGULURU</span>
                <span class="branch-type"><strong>Campus Type:</strong> Residential Campus</span>
                <span class="campus-gender boys"><i class="fa-solid fa-person"></i> Boys Campus</span>
            </div>

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Stanford Campus - MADHAPUR</span>
                <span class="branch-type"><strong>Campus Type:</strong> Residential Campus</span>
                <span class="campus-gender girls"><i class="fa-solid fa-person-dress"></i> Girls Campus</span>
            </div>

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Boston Campus - MADINAGUDA</span>
                <span class="branch-type"><strong>Campus Type:</strong> Day Scholar Campus</span>
                <span class="campus-gender day"><i class="fa-solid fa-sun"></i> Day Scholar</span>
            </div>

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Michigan Campus - KUKATPALLY</span>
                <span class="branch-type"><strong>Campus Type:</strong> Day Scholar Campus</span>
                <span class="campus-gender day"><i class="fa-solid fa-sun"></i> Day Scholar</span>
            </div>

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Cornell Campus - LBNAGAR</span>
                <span class="branch-type"><strong>Campus Type:</strong> Day Scholar / Semi-Residential Campus</span>
                <span class="campus-gender day"><i class="fa-solid fa-house"></i> Day / Semi-Residential</span>
            </div>

        </div>
    </div>

    <!-- VIJAYAWADA -->
    <div class="location-group">
        <h3 class="location-heading">
            <i class="fa-solid fa-location-dot"></i> Vijayawada
        </h3>

        <div class="branch-list">

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Harvard Campus - RAMAVARAPADU</span>
                <span class="branch-type"><strong>Campus Type:</strong> Residential / Semi-Residential / Day Scholar Campus</span>
                <span class="campus-gender boys"><i class="fa-solid fa-person"></i> Boys Campus</span>
            </div>

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Stanford Campus - RAMAVARAPADU</span>
                <span class="branch-type"><strong>Campus Type:</strong> Residential / Semi-Residential / Day Scholar Campus</span>
                <span class="campus-gender girls"><i class="fa-solid fa-person-dress"></i> Girls Campus</span>
            </div>

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Boston Campus - LABBIPET</span>
                <span class="branch-type"><strong>Campus Type:</strong> Day Scholar / Semi-Residential Campus</span>
                <span class="campus-gender day"><i class="fa-solid fa-house"></i> Day / Semi-Residential</span>
            </div>

        </div>
    </div>

    <!-- GUNTUR -->
    <div class="location-group">
        <h3 class="location-heading">
            <i class="fa-solid fa-location-dot"></i> Guntur
        </h3>

        <div class="branch-list">

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Harvard Campus - PEDDAPALAKLURU</span>
                <span class="branch-type"><strong>Campus Type:</strong> Residential Campus</span>
                <span class="campus-gender boys"><i class="fa-solid fa-person"></i> Boys Campus</span>
            </div>

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Stanford Campus - REDDY PALEM</span>
                <span class="branch-type"><strong>Campus Type:</strong> Residential Campus</span>
                <span class="campus-gender girls"><i class="fa-solid fa-person-dress"></i> Girls Campus</span>
            </div>

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Queensland - ASHOKNAGAR</span>
                <span class="branch-type"><strong>Campus Type:</strong> Residential Campus</span>
                <span class="campus-gender girls"><i class="fa-solid fa-person-dress"></i> Girls Campus</span>
            </div>

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Boston Campus - ZUDIO BUILDING</span>
                <span class="branch-type"><strong>Campus Type:</strong> Day Scholar / Semi-Residential Campus</span>
                <span class="campus-gender day"><i class="fa-solid fa-house"></i> Day / Semi-Residential</span>
            </div>

        </div>
    </div>

    <!-- VIZAG -->
    <div class="location-group">
        <h3 class="location-heading">
            <i class="fa-solid fa-location-dot"></i> Vizag
        </h3>

        <div class="branch-list">

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Harvard Campus - CARSHED JUNCTION</span>
                <span class="branch-type"><strong>Campus Type:</strong> Residential / Semi-Residential / Day Scholar Campus</span>
                <span class="campus-gender boys"><i class="fa-solid fa-person"></i> Boys Campus</span>
            </div>

            <div class="branch">
                <span class="branch-campus"><i class="fa-solid fa-location-dot"></i> Stanford Campus - CARSHED JUNCTION</span>
                <span class="branch-type"><strong>Campus Type:</strong> Residential / Semi-Residential / Day Scholar Campus</span>
                <span class="campus-gender girls"><i class="fa-solid fa-person-dress"></i> Girls Campus</span>
            </div>

        </div>
    </div>

</section>

<hr class="divider">

<!-- CONTACT INFORMATION -->
<section aria-label="Contact information">
    <h2 class="section-title">Contact Us</h2>

    <div class="contact">

        <div>
            <i class="fa-solid fa-envelope" style="color:#f45120"></i>
            <span class="contact-label">Email:</span>
            <a href="mailto:info@dhanikbharat.org">info@dhanikbharat.org</a>
        </div>

        <div>
            <i class="fa-solid fa-phone" style="color:#e34b76"></i>
            <span class="contact-label">Phone:</span>
            <a href="tel:+919555825559">+91 955582 5559</a>
        </div>

        <div class="address-block">
            <span class="contact-label">
                <i class="fa-solid fa-building"></i> Registered Office:
            </span>
            <br>
            Unit No. 3A, Wing B, 2nd Floor,<br>
            Times Square, Marol, Andheri (East),<br>
            Mumbai – 400059
        </div>

        <div class="address-block">
            <span class="contact-label">
                <i class="fa-solid fa-building"></i> Corporate Office:
            </span>
            <br>
            Sai Plaza, MIG 366, 4th Floor,<br>
            KPHB Colony, Kukatpally,<br>
            Hyderabad, Telangana – 500072
        </div>

    </div>
</section>

<footer class="footer">
    © 2027–2028 Dhanik Bharat Educational Institutions. All rights reserved.
</footer>

</main>
</body>
</html>
